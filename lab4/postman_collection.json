        {
          "name": "Получить CSRF-токен",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Запрос без аутентификации",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Чтение заявителем",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "petrov" },
                { "key": "password", "value": "Petrov12345" }
              ]
            },
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Заблокированная учётная запись",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "kozlova" },
                { "key": "password", "value": "Kozlova12345" }
              ]
            },
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Неверный пароль",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "petrov" },
                { "key": "password", "value": "wrong" }
              ]
            },
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"orlov\", \"fullName\": \"Павел Орлов\", \"email\": \"orlov@example.com\", \"password\": \"Orlov12345!\", \"role\": \"STAFF\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUserId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Повторная регистрация",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"orlov\", \"fullName\": \"Павел Орлов\", \"email\": \"other@example.com\", \"password\": \"Orlov12345!\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Слабый пароль",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"weak\", \"fullName\": \"Слабый Пароль\", \"email\": \"weak@example.com\", \"password\": \"short1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Текущая учётная запись",
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "orlov" },
                { "key": "password", "value": "Orlov12345!" }
              ]
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
